{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hoist",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	// Cloudflare builds other branches (pull requests) with `wrangler preview`,
	// which needs this block, even empty; the previews use the settings above.
	"previews": {}
}
